{
  "name": "meridianed-server",
  "version": "0.1.0",
  "description": "MeridianEd MVP backend — Express + PostgreSQL (node:sqlite local fallback)",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
