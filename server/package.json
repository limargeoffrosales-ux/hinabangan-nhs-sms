{
  "name": "meridianed-server",
  "version": "0.1.0",
  "description": "MeridianEd MVP backend — Express + PostgreSQL (node:sqlite local fallback)",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "backup": "node scripts/backup.js",
    "backup:list": "node scripts/backup.js --list",
    "backup:cleanup": "node scripts/backup.js --cleanup",
    "backup:drill": "node scripts/backup.js --drill",
    "programs:generate": "node --env-file-if-exists=.env src/generate-programs.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@huggingface/transformers": "^4.3.0",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.5.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "eslint": "^8.57.1",
    "typescript": "^7.0.2"
  }
}
