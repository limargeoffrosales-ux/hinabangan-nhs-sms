{
  "name": "meridianed-server",
  "version": "0.1.0",
  "description": "MeridianEd MVP backend — Express + PostgreSQL (node:sqlite local fallback)",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "backup": "node scripts/backup.js",
    "backup:list": "node scripts/backup.js --list",
    "backup:cleanup": "node scripts/backup.js --cleanup",
    "backup:drill": "node scripts/backup.js --drill",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@sentry/node": "^10.74.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.15.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  }
}
