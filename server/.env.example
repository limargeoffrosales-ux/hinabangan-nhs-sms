# Copy to .env for local use; on Render set these in the dashboard instead.

# Port the API listens on (Render sets this automatically)
PORT=4000

# PostgreSQL connection string (Neon). If unset, uses local SQLite (dev only).
# DATABASE_URL=postgresql://user:password@host/db

# Secret for signing JWTs — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (default 15m)
# ACCESS_TTL=15m

# Refresh token lifetime in days (default 14)
# REFRESH_TTL_DAYS=14

# DepEd grade weights (JSON)
# GRADE_WEIGHTS={"written_work":25,"performance_task":45,"quarterly_exam":30}

# --- Email notifications (SMTP) -----------------------------------------------
# Leave SMTP_HOST empty and emails are recorded as queued (retried once a host is set).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=no-reply@school.edu.ph
# SMTP_PASS=app-password
# MAIL_FROM="Hinabangan NHS <no-reply@school.edu.ph>"
# NOTIFY_EMAIL_MODE=smtp   # 'stream' = capture mail without sending (tests only)

# --- SMS notifications (generic HTTP provider) ---------------------------------
# Any relay accepting POST {to, from, message} with Authorization: Bearer <token>.
# Leave empty and SMS is recorded as queued (retried once a provider is set).
# SMS_PROVIDER_URL=https://sms-relay.example.com/send
# SMS_PROVIDER_TOKEN=...
# SMS_SENDER=SCHOOL

# --- Notification defaults ------------------------------------------------------
# NOTIFY_EMAIL_ENABLED=1
# NOTIFY_SMS_ENABLED=0
