# Copy to .env for local use; on Render set these in the dashboard instead.
# No secrets should ever be committed to the repository.

# --- Core ---------------------------------------------------------------------
# Port the API listens on (Render sets this automatically)
PORT=4000

# Public base URL of the app — used to build password-reset links in emails.
# Set to your Render service URL in production (e.g. https://hinabangan-nhs.onrender.com).
# When empty, reset links fall back to the request's Host header.
# APP_URL=https://hinabangan-nhs.onrender.com

# PostgreSQL connection string (Neon). If unset, uses local SQLite (dev only).
# Use a DIRECT endpoint in production (no -pooler): the app pins search_path=public
# and pooled strings can leak SET/session state across connections (see AGENTS.md).
# DATABASE_URL=postgresql://user:password@host/db

# Secret for signing JWTs — REQUIRED. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (default 15m)
# ACCESS_TTL=15m

# Refresh token lifetime in days (default 14)
# REFRESH_TTL_DAYS=14

# DepEd grade weights (JSON)
# GRADE_WEIGHTS={"written_work":25,"performance_task":45,"quarterly_exam":30}

# --- Email notifications (SMTP) -----------------------------------------------
# Leave SMTP_HOST empty and emails are recorded as queued (retried once a host is set).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=no-reply@school.edu.ph
# SMTP_PASS=app-password
# MAIL_FROM="Hinabangan NHS <no-reply@school.edu.ph>"
# NOTIFY_EMAIL_MODE=smtp   # 'stream' = capture mail without sending (tests only)

# --- SMS notifications (generic HTTP provider) ---------------------------------
# Any relay accepting POST {to, from, message} with Authorization: Bearer <token>.
# A provider can ALSO be configured at runtime in the app (Notifications page,
# saved to app_settings) — no server change or redeploy needed — with env as the
# fallback. Alternatively set SMS_PROVIDER_URL=textbelt to use the built-in free
# no-signup gateway (1 real SMS/phone/day) and prove the end-to-end path.
# Leave everything empty and SMS runs in SIMULATOR mode in dev/demo: the whole
# flow works and messages are logged as 'simulated' (no real SMS is sent), so
# every feature is exercisable with zero accounts today.
# SMS_PROVIDER_URL=https://sms-relay.example.com/send
# SMS_PROVIDER_TOKEN=...
# SMS_SENDER=SCHOOL

# --- Notification defaults ------------------------------------------------------
# NOTIFY_EMAIL_ENABLED=1
# NOTIFY_SMS_ENABLED=0

# --- Push notifications (Firebase Cloud Messaging HTTP v1) ----------------------
# The legacy key-based FCM API was retired by Google in June 2024. v1 needs a
# Firebase service account JSON (Contents of the .json downloaded from
# Firebase console > Project settings > Service accounts). Set as a single line.
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- AI assistant (super-admin only) -------------------------------------------
# Default provider is Groq serving GPT-OSS 120B (open weights, free tier) — get a
# key at console.groq.com. No key? Use AI_PROVIDER=native: a local LLM
# (transformers.js/ONNX WASM). Requires no account/install; the model downloads
# once from the HF Hub on first use, then runs fully offline.
# GROQ_API_KEY=                                            # from console.groq.com (free)
# AI_PROVIDER=groq                                        # openai | groq | ollama | hf | native
# AI_MODEL=openai/gpt-oss-120b
# For AI_PROVIDER=native: default is the local onnx-community/Qwen2.5-1.5B-Instruct
# (coherent, ~45s warm). On low-RAM boxes use onnx-community/Qwen2.5-0.5B-Instruct.
# AI_MODEL=onnx-community/Qwen2.5-1.5B-Instruct
# AI_ALLOW_STUDENT_DATA=1                                  # opt-in: skip the student-data consent gate (local/dev/demo only)

# --- Cloudflare R2 (S3-compatible object storage) -------------------------------
# Student photos, enrollment documents and submissions live here.
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=meridianed-files
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# Public bucket URL (e.g. https://pub-<id>.r2.dev). LEAVE EMPTY for a PRIVATE
# bucket — the app then serves files through /api/v1/uploads/file/<key> using
# short-lived presigned URLs (requires a session) instead of the public CDN.
# R2_PUBLIC_URL=
# Max upload size in MB (default 10).
# UPLOAD_MAX_MB=10

# --- Placement map geocoding (Work Immersion / JDVP tracing) -------------------
# Resolves the partner ADDRESS typed on each record into a map pin using
# OpenStreetMap Nominatim (free, no API key). Enabled by default.
# GEOCODE_DISABLED=1      # never call out (e.g. offline installs)
# GEOCODE_URL=            # override endpoint (self-hosted Nominatim / tests)
# GEOCODE_USER_AGENT=HinabanganNHS-SMS/1.0
# GEOCODE_MIN_INTERVAL_MS=1150

# --- Storage retention sweep (optional, off by default) -------------------------
# Deletes old generated documents and submission files + their R2 objects.
# DOC_GENERATION_RETENTION_DAYS=90
# SUBMISSION_FILE_RETENTION_DAYS=180

# --- Automated database backups (optional, off by default) ----------------------
# Runs inside the API process (no cron needed) and works on Render free tier.
# Backups are written to BACKUP_DIR (default: <DATA_DIR>/backups) and, when R2 is
# configured, uploaded under backups/meridianed/ so they survive disk resets.
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETAIN=5
# BACKUP_DIR=             # override local backup folder (default <DATA_DIR>/backups)
# BACKUP_R2_PREFIX=backups/meridianed
# BACKUP_DRILL_ENABLED=1  # also run a restore drill after each backup (verify restores work)
# Manual use: npm run backup            (create now)
#             npm run backup:drill      (test restore of newest backup into isolated schema)
#             npm run backup:list       (list local backups)